# Copia a apps/api/.env y ajusta. NO versionar el .env real.
DATABASE_URL=postgresql://postgres@localhost:5432/control_accesos?schema=public

API_PORT=3001
NODE_ENV=development

# Secretos (genera cada uno distinto, >= 32 chars):
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=genera_un_secreto_de_64_caracteres
JWT_REFRESH_SECRET=genera_otro_secreto_de_64_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
QR_SIGNING_SECRET=genera_un_secreto_de_64_caracteres_para_qr

PRESENCIA_RESET_HORAS=24
WEB_ORIGIN=http://localhost:5173

# Opcional: credenciales del super admin para el seed
# SEED_ADMIN_EMAIL=admin@ejemplo.com
# SEED_ADMIN_PASSWORD=UnaContrasenaLarga
