{
  "name": "thinktech-control-accesos",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de control de acceso vehicular y peatonal por QR para parques industriales (ThinkTech).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@12.17.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "api:dev": "pnpm --filter @acceso/api start:dev",
    "web:dev": "pnpm --filter @acceso/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test"
  },
  "license": "UNLICENSED"
}
