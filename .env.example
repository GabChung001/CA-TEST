# ───────────────────────────────────────────────────────────────
# Copia este archivo a ".env" y ajusta los valores.
# NUNCA subas el ".env" real al repositorio.
# ───────────────────────────────────────────────────────────────

# Base de datos (PostgreSQL local en el servidor de caseta)
POSTGRES_USER=acceso
POSTGRES_PASSWORD=cambia_esta_contrasena
POSTGRES_DB=control_accesos
DATABASE_URL=postgresql://acceso:cambia_esta_contrasena@localhost:5432/control_accesos?schema=public

# API
API_PORT=3001
NODE_ENV=development

# Seguridad — genera valores aleatorios largos (ver README)
JWT_ACCESS_SECRET=genera_un_secreto_de_64_caracteres
JWT_REFRESH_SECRET=genera_otro_secreto_de_64_caracteres
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Firma de QR (HMAC) — clave dedicada, distinta a las de JWT
QR_SIGNING_SECRET=genera_un_secreto_de_64_caracteres_para_qr

# Reset de presencia (anti-passback): horas sin marcar salida tras las que se libera
PRESENCIA_RESET_HORAS=24

# Frontend
WEB_PORT=5173
VITE_API_URL=http://localhost:3001
